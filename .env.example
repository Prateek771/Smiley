# Native PostgreSQL 18. Use npm run db:setup with a private LOCAL_POSTGRES_ADMIN_URL for a new installation.
DATABASE_URL=postgresql://smiley_app:REPLACE_WITH_LOCAL_SECRET@127.0.0.1:5432/sehospitaldb
TEST_DATABASE_URL=postgresql://smiley_app:REPLACE_WITH_LOCAL_SECRET@127.0.0.1:5432/sehospitaldb_test
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
BETTER_AUTH_URL=http://localhost:3000
PRIVATE_STORAGE_DIR="./tmp/private-storage"
MIGRATION_DATABASE_URL=postgresql://smiley_migrator:REPLACE_WITH_LOCAL_SECRET@127.0.0.1:5432/sehospitaldb
TEST_MIGRATION_DATABASE_URL=postgresql://smiley_migrator:REPLACE_WITH_LOCAL_SECRET@127.0.0.1:5432/sehospitaldb_test
LOCAL_POSTGRES_SERVICE=postgresql-x64-18

# Synthetic cloud extraction only; never expose these as NEXT_PUBLIC variables.
OCR_SPACE_API_KEY=REPLACE_WITH_PRIVATE_OCR_SPACE_KEY
OPENROUTER_API_KEY=REPLACE_WITH_PRIVATE_OPENROUTER_KEY
OPENROUTER_MODEL=qwen/qwen3.8-27b:free
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
